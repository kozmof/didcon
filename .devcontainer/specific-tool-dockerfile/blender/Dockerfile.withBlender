# based on https://github.com/anthropics/claude-code/tree/main/.devcontainer
# and https://www.chainguard.dev/unchained/migrating-a-node-js-application-to-chainguard-images
#
# Blender addon development variant: headless Blender + uv.
#
# NOTE ON BUILD CONTEXT. This Dockerfile lives two directories below its
# siblings, but every COPY below is still relative to .devcontainer, so that
# directory must remain the build context:
#
#   docker build --pull -f .devcontainer/specific-tool-dockerfile/blender/Dockerfile.withBlender .devcontainer
#
# and in devcontainer.json:
#
#   "build": {
#     "dockerfile": "specific-tool-dockerfile/blender/Dockerfile.withBlender",
#     "context": ".",
#     "options": ["--pull"]
#   }
#
# Pointing the context at this subdirectory instead will fail on the first COPY.

# Build island (https://github.com/landlock-lsm/island) — Landlock-based filesystem sandbox.
# Uses +crt-static to produce a fully static binary that works in any Linux environment.
FROM cgr.dev/chainguard/rust:latest-dev AS island-builder
USER root
ENV CARGO_HOME=/cargo
ARG ISLAND_REV=05a9d699fbf30289fd2af4311becf38ceb334df2
# No --locked: island publishes no Cargo.lock, and the base image's
# cargo-auditable wrapper shells out to `cargo metadata`, which then cannot
# create one and aborts the build. ISLAND_REV is what pins the source.
RUN cargo install --git https://github.com/landlock-lsm/island --rev ${ISLAND_REV} island

FROM cgr.dev/chainguard/node:latest-dev

# Option: specify versions explicitly
ARG CLAUDE_CODE_VERSION=latest
ARG CODEX_VERSION=latest
ARG NPM_VERSION=11.17.0
ARG PNPM_VERSION=10.17.1

# Switch to root for package installation
USER root

# Copy island binary from builder stage
COPY --from=island-builder /cargo/bin/island /usr/local/bin/island

# Install basic development tools and iptables/ipset.
# xz is required to unpack the Blender release tarball (.tar.xz).
#
# The libx11/libxi/.../mesa-gl block is Blender's runtime shared-library set.
# A headless image still needs it: the official Blender build links X11 and GL
# unconditionally, so `blender -b` fails at load time without them even though it
# never opens a window. Verified with `ldd /usr/local/blender/blender` against
# this base — with these packages installed, nothing resolves to "not found".
RUN apk update && apk add \
  less \
  git \
  procps \
  fzf \
  man-db \
  unzip \
  xz \
  gnupg \
  iptables \
  ipset \
  iproute2 \
  bind-tools \
  jq \
  wget \
  bash \
  su-exec \
  libx11 \
  libxi \
  libxxf86vm \
  libxfixes \
  libxrender \
  libxext \
  libsm \
  libice \
  mesa-gl \
  mesa-egl \
  libxkbcommon \
  wayland-libs-client \
  && rm -rf /var/cache/apk/*

ARG BLENDER_SERIES=4.5
ARG BLENDER_VERSION=4.5.14
ARG BLENDER_SHA256=9ba871ff2ecd36526b77432745980b7e6664ecd0c7ca11c48849073dcfe06da3

# Install the pinned Blender LTS release tarball under /usr/local/blender.
# Not /opt/blender: every island agent policy already grants read+execute on /usr,
# so /usr/local/blender needs no per-image policy overlay the way /opt/rust does.
# Not /usr/local/bin either — that path is reserved for island shims.
# Blender resolves its scripts and datafiles directory (4.5/) relative to the
# binary, so the tarball layout has to stay intact; --strip-components=1 keeps
# blender and 4.5/ together.
RUN wget -q https://download.blender.org/release/Blender${BLENDER_SERIES}/blender-${BLENDER_VERSION}-linux-x64.tar.xz -O /tmp/blender.tar.xz && \
    echo "${BLENDER_SHA256}  /tmp/blender.tar.xz" | sha256sum -c - && \
    mkdir -p /usr/local/blender && \
    tar -C /usr/local/blender --strip-components=1 -xJf /tmp/blender.tar.xz && \
    rm /tmp/blender.tar.xz && \
    chown -R root:root /usr/local/blender && \
    chmod -R go-w /usr/local/blender && \
    /usr/local/blender/blender --version

ARG UV_VERSION=0.12.17
ARG UV_SHA256=fa82fd8dde8e8eefdecada6aa0889666556cfceb690d06e0c3bca49eb3070a63

# Install the pinned uv release under /usr/local/uv, same reasoning as
# /usr/local/blender above. The -gnu triple, not -musl: Wolfi is glibc.
# Root-owned is what makes `uv self update` fail, which is deliberate — uv is a
# centrally managed asset like codex and herdr. See docs/version-bumps.md.
RUN wget -q https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz -O /tmp/uv.tar.gz && \
    echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum -c - && \
    mkdir -p /usr/local/uv && \
    tar -C /usr/local/uv --strip-components=1 -xzf /tmp/uv.tar.gz && \
    rm /tmp/uv.tar.gz && \
    chown -R root:root /usr/local/uv && \
    chmod 0755 /usr/local/uv/uv /usr/local/uv/uvx && \
    chmod -R go-w /usr/local/uv && \
    /usr/local/uv/uv --version && \
    /usr/local/uv/uvx --version

# Appended, not prepended: /usr/local/bin must keep resolving first so `blender`,
# `uv`, and `uvx` hit the island shims. The full paths stay the deliberate
# sandbox bypass.
ENV PATH=$PATH:/usr/local/blender:/usr/local/uv

# Optional: herdr, a terminal agent-multiplexer (https://herdr.dev/).
# Pinned release binary with SHA256 verification, root-owned so it cannot
# self-update. Installed under /opt/herdr (not /usr/local/bin, which is
# reserved for island shims); /usr/local/bin/herdr is the sandboxing shim.
# herdr.dev is intentionally NOT firewall-whitelisted at runtime.
ARG INSTALL_HERDR=false
ARG HERDR_VERSION=0.7.4
ARG HERDR_SHA256=bc0fc02d4ba500f9cac2353a43e67fe036785ecca6eb55378e050fac3c103059
RUN if [ "$INSTALL_HERDR" = "true" ]; then \
      wget -q https://github.com/ogulcancelik/herdr/releases/download/v${HERDR_VERSION}/herdr-linux-x86_64 -O /tmp/herdr && \
      echo "${HERDR_SHA256}  /tmp/herdr" | sha256sum -c - && \
      mkdir -p /opt/herdr/bin && \
      install -o root -g root -m 0755 /tmp/herdr /opt/herdr/bin/herdr && \
      rm /tmp/herdr && \
      /opt/herdr/bin/herdr --version ; \
    fi

ARG USERNAME=dev

# Create non-root user
RUN addgroup ${USERNAME} && adduser -D -G ${USERNAME} -s /bin/bash ${USERNAME}

# Agent and package-manager binaries are enforcement assets. Keep them root-owned.
RUN mkdir -p /usr/local/share/npm-global

# Persist bash history.
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE=/commandhistory/.bash_history" \
  && mkdir /commandhistory \
  && touch /commandhistory/.bash_history \
  && chown -R ${USERNAME} /commandhistory

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Create workspace and config directories and set permissions.
# config/codex must pre-exist: the codex island profile sets CODEX_HOME there
# and codex errors out instead of creating a missing directory.
# .aikido must pre-exist so the herdr Landlock policy can bind a rule to it
# (safe-chain writes its malware-scan state there).
# Blender's user resources and uv's caches are not created here: they live under
# /workspace (.blender-user, .uv-cache, .uv-python, .uv-tools), and /workspace is
# a bind mount at runtime, so anything written there at build time is masked.
# Both tools create their directories on first use.
RUN mkdir -p /workspace /home/${USERNAME}/.claude /home/${USERNAME}/.codex/tmp/arg0 \
    /home/${USERNAME}/.aikido \
    /home/${USERNAME}/.island/claude/config /home/${USERNAME}/.island/claude/data \
    /home/${USERNAME}/.island/claude/cache /home/${USERNAME}/.island/claude/state \
    /home/${USERNAME}/.island/claude/runtime /home/${USERNAME}/.island/claude/tmp \
    /home/${USERNAME}/.island/codex/config/codex /home/${USERNAME}/.island/codex/data \
    /home/${USERNAME}/.island/codex/cache /home/${USERNAME}/.island/codex/state \
    /home/${USERNAME}/.island/codex/runtime /home/${USERNAME}/.island/codex/tmp \
    /home/${USERNAME}/.island/herdr/config /home/${USERNAME}/.island/herdr/data \
    /home/${USERNAME}/.island/herdr/cache /home/${USERNAME}/.island/herdr/state \
    /home/${USERNAME}/.island/herdr/runtime /home/${USERNAME}/.island/herdr/tmp \
    /home/${USERNAME}/.config/npm && \
  chown -R ${USERNAME}:${USERNAME} /workspace /home/${USERNAME}/.claude /home/${USERNAME}/.codex \
    /home/${USERNAME}/.aikido \
    /home/${USERNAME}/.island /home/${USERNAME}/.config

# Codex updates are centrally managed: the CLI is a root-owned enforcement
# asset installed at build time, so its self-update (`npm install -g @openai/codex`)
# cannot write to /usr/local/share/npm-global and fails with EACCES. Seed
# config.toml in both CODEX_HOME locations — the island shim's home and the
# default ~/.codex used by the direct-path bypass — so codex never offers an
# upgrade it structurally cannot perform.
RUN printf 'check_for_update_on_startup = false\n' | tee \
      /home/${USERNAME}/.island/codex/config/codex/config.toml \
      /home/${USERNAME}/.codex/config.toml >/dev/null && \
    chown ${USERNAME}:${USERNAME} \
      /home/${USERNAME}/.island/codex/config/codex/config.toml \
      /home/${USERNAME}/.codex/config.toml

# Public registry policy is root-owned and contains no credentials.
COPY .npmrc /etc/npmrc
RUN chmod 0444 /etc/npmrc

# The Python half of the same registry policy: both files point pip and uv at the
# Takumi Guard PyPI proxy, which blocks known-malicious packages and quarantines
# newly published ones. Two files because the two tools read different config —
# uv deliberately does not read PIP_INDEX_URL or pip.conf, and pip does not read
# uv.toml. pip.conf matters because Blender bundles its own CPython, and addon
# projects do reach for its pip.
#
# /etc/uv/uv.toml is uv's *system-level* config, which is its lowest precedence
# tier: a project's own uv.toml in /workspace overrides it. That is fine for the
# deliberate full-path bypass, but not for the sandboxed path, so the
# uv-workspace island profile also forces UV_DEFAULT_INDEX — environment
# variables outrank all persistent config.
COPY specific-tool-dockerfile/blender/uv.toml /etc/uv/uv.toml
COPY specific-tool-dockerfile/blender/pip.conf /etc/pip.conf
COPY specific-tool-dockerfile/blender/blender-stubs.txt /etc/uv/blender-stubs.txt
RUN chmod 0444 /etc/uv/uv.toml /etc/pip.conf /etc/uv/blender-stubs.txt

WORKDIR /workspace

# Set up non-root user
USER dev

# Install global packages
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin

# Set the default editor and visual
ENV EDITOR=vi
ENV VISUAL=vi

# Install npm itself into the npm-global prefix so the shim can find it at
# /usr/local/share/npm-global/bin/npm, then install Claude Code.
# Both installs happen before the npm shim is in place, so they run unsandboxed.
# npm invoked as root runs lifecycle scripts as an unprivileged user, so
# claude-code's postinstall cannot replace its root-owned bin/claude.exe
# placeholder with the native binary — run install.cjs explicitly, then
# `claude --version` so the build fails if the binary is still the stub.
USER root
RUN npm install -g npm@${NPM_VERSION} && \
    npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && \
    npm install -g @openai/codex@${CODEX_VERSION} && \
    npm install -g pnpm@${PNPM_VERSION} && \
    node /usr/local/share/npm-global/lib/node_modules/@anthropic-ai/claude-code/install.cjs && \
    /usr/local/share/npm-global/bin/claude --version && \
    chown -R root:root /usr/local/share/npm-global && \
    chmod -R go-w /usr/local/share/npm-global && \
    # The pnpm shim (/usr/local/bin/pnpm) execs the real binary at /usr/bin/pnpm,
    # so point that at the pinned, root-owned npm-global install (root ownership
    # prevents self-update). Projects that set package.json's "packageManager"
    # field should also set manage-package-manager-versions=false, since pnpm's
    # self-install re-enters the Island/Landlock sandbox and fails (E2BIG).
    ln -sf /usr/local/share/npm-global/bin/pnpm /usr/bin/pnpm && \
    /usr/bin/pnpm --version

# Switch back to root to deploy island profiles, shims, and shell aliases
USER root

# Island profiles (Landlock sandbox policies per-tool).
# No profiles-blender/ overlay is needed, unlike the Rust image: both toolchains
# live under /usr/local, which the agent policies already cover through their
# /usr read+execute grant, so cargo's /opt/rust nesting problem does not arise
# here. Same reason Dockerfile.withGo and Dockerfile.withZig need no overlay.
COPY island/profiles/ /etc/island/profiles/
RUN chown -R root:root /etc/island && chmod -R go-w,a+rX /etc/island

# Binary shims: wrap npm, git, pnpm, claude, codex, blender, uv, uvx, and herdr
# with island sandboxing.  These shims are installed to /usr/local/bin/, which
# must appear before /usr/bin/, /usr/local/blender, and /usr/local/uv in PATH so
# that `git`, `npm`, `blender`, `uv`, etc. resolve to the shims rather than the
# real binaries.  Reordering PATH to put those dirs first would silently bypass
# the sandbox for those tools — the Landlock policies would no longer apply to
# hooks, postinstall scripts, addon code run by `blender -b --python`, or the
# setup.py of an sdist that uv builds.
COPY scripts/shims/ /usr/local/bin/
RUN chmod 755 /usr/local/bin/npm /usr/local/bin/git /usr/local/bin/pnpm /usr/local/bin/claude /usr/local/bin/codex /usr/local/bin/blender /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/herdr

# Shell alias: 'claude' runs via island claude-code profile
COPY --chown=${USERNAME}:${USERNAME} bash_aliases /home/${USERNAME}/.bash_aliases
RUN printf '[ -f ~/.bash_aliases ] && . ~/.bash_aliases\n' > /home/${USERNAME}/.bashrc && \
    chown ${USERNAME}:${USERNAME} /home/${USERNAME}/.bashrc

# Switch back to root for firewall setup
USER root

# Set up network firewall scripts and log infrastructure
COPY scripts/ /opt/scripts/
COPY extra-whitelist.conf /opt/scripts/extra-whitelist.conf
RUN chmod +x /opt/scripts/*.sh && \
    touch /var/log/firewall.log /var/log/firewall-status.txt && \
    chmod 644 /var/log/firewall.log /var/log/firewall-status.txt

ENTRYPOINT ["/opt/scripts/entrypoint.sh"]
CMD ["sleep", "infinity"]
